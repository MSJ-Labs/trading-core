# Copy this file to .env and fill in the values.
# .env is gitignored and never committed.

# Optional — CoinGecko Demo API key (free at coingecko.com/api)
# Leave empty to use the unauthenticated public endpoint (rate-limited)
COINGECKO_API_KEY=

# Keycloak (identity provider) - local dev values, use strong unique ones elsewhere
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me
# Secret of the bootstrap service account "terraform" (master realm). Keycloak creates it at first start,
# Terraform logs in with it. Generate with: openssl rand -base64 32
TERRAFORM_CLIENT_SECRET=
# The values below are given to Terraform, not to Keycloak: export them as TF_VAR_<lowercase name>
# (see "Identity" in CLAUDE.md), e.g. TF_VAR_trading_bff_client_secret.
# Secret of the confidential client trading-bff. Generate with: openssl rand -base64 32
TRADING_BFF_CLIENT_SECRET=
# Password of the dev-user and dev-admin accounts (min 12 chars, realm password policy)
DEV_USER_PASSWORD=
